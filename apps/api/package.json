{
  "name": "@jupiter/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate --no-hints && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "db:setup": "bash scripts/db-setup.sh && prisma migrate deploy",
    "db:seed": "node dist/seed.js",
    "test": "tsc -p tsconfig.build.json && vitest run",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "3.700.0",
    "@jupiter/ai": "workspace:*",
    "@jupiter/einvoice": "workspace:*",
    "@jupiter/fx": "workspace:*",
    "@jupiter/ledger": "workspace:*",
    "@jupiter/licensing": "workspace:*",
    "@jupiter/operations": "workspace:*",
    "@jupiter/payroll": "workspace:*",
    "@jupiter/statements": "workspace:*",
    "@jupiter/tax-engine": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "jsonwebtoken": "^9.0.3",
    "otplib": "12.0.1",
    "pg": "^8.23.1",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.1",
    "supertest": "7.3.1"
  }
}