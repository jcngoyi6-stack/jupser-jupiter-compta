# Rôle applicatif (sans BYPASSRLS) — utilisé par l'API
DATABASE_URL=postgresql://jupiter_app:app_dev_pw@localhost:5432/jupiter
# Rôle propriétaire — utilisé uniquement par les migrations Prisma
DATABASE_OWNER_URL=postgresql://jupiter_owner:owner_dev_pw@localhost:5432/jupiter
JWT_SECRET=change-me-dev-only-64-chars-minimum-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Clé maîtresse (32 octets base64) — en production : KMS/HSM
MASTER_KEY=ZGV2LW1hc3Rlci1rZXktMzItYnl0ZXMtbG9uZyEhISE=
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
PUBLIC_VERIFY_BASE_URL=http://localhost:3000/verifier
PORT=4000
# Optionnel : active Jupiter IA via l'API Claude (sinon mode hors ligne)
ANTHROPIC_API_KEY=

# Adresses publiques (redirections de paiement et SSO)
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# Facture normalisée RDC (e-MCF de la DGI) — sans ces variables : simulateur, refusé en production
RDC_EMCF_URL=
RDC_EMCF_TOKEN=

# Prestataires de paiement (après contrat) — sans eux : simulateur, refusé en production
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
# ALLOW_PAYMENT_SIMULATOR=true   # uniquement pour une préproduction

# Cours de change : flux BCC convenu ({ rates: { USD: "…" } }) et source commerciale de secours
FX_BCC_URL=
FX_FALLBACK_URL=

# Licences hors ligne (Ed25519, PEM ; « \n » accepté) — en développement : paire éphémère
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=

# Stockage S3/MinIO des pièces (sinon chiffrées en base)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Messagerie sortante (sinon simulation journalisée)
SMS_API_URL=
SMS_API_TOKEN=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
MAIL_API_URL=
MAIL_API_TOKEN=
