{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jupiter Compta",
  "version": "0.1.0",
  "identifier": "cd.jupser.jupitercompta",
  "build": {
    "frontendDist": "https://app.jupiter-compta.example",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      { "title": "Jupiter Compta", "width": 1366, "height": 860, "minWidth": 1024, "minHeight": 680, "resizable": true }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "deb", "appimage"],
    "icon": ["icons/64x64.png", "icons/icon.png"],
    "publisher": "JUPSER",
    "copyright": "© JUPSER — Jupiter Services SARLU",
    "category": "Finance",
    "shortDescription": "ERP de gestion d’entreprise conforme au SYSCOHADA révisé"
  }
}
